#!/usr/bin/env bash
set -euo pipefail

readonly retention="8 hours"
readonly system_profile="/nix/var/nix/profiles/system"
readonly cutoff="$(date --date="$retention ago" +%s)"
readonly dry_run="${1:-}"

if [[ $# -gt 1 || ( -n "$dry_run" && "$dry_run" != "--dry-run" ) ]]; then
  echo "Usage: $0 [--dry-run]" >&2
  exit 2
fi

# Query the system profile through sudo because it is owned by root.
system_generations="$(sudo nix-env --profile "$system_profile" --list-generations)"
declare -a system_remove=()
while IFS= read -r line; do
  if [[ "$line" =~ ^[[:space:]]*([0-9]+)[[:space:]]+([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]+([0-9]{2}:[0-9]{2}:[0-9]{2}) ]]; then
    generation_id="${BASH_REMATCH[1]}"
    generation_date="${BASH_REMATCH[2]}"
    generation_clock="${BASH_REMATCH[3]}"
    [[ "$line" == *"(current)"* ]] && continue
    generation_time="$(date --date="$generation_date $generation_clock" +%s)"
    if (( generation_time < cutoff )); then
      system_remove+=("$generation_id")
    fi
  fi
done <<< "$system_generations"

if [[ "$dry_run" == "--dry-run" ]]; then
  printf 'Would remove NixOS generation IDs: %s\n' "${system_remove[*]:-(none)}"
  exit 0
fi

if ((${#system_remove[@]})); then
  printf 'Removing NixOS generations: %s\n' "${system_remove[*]}"
  sudo nix-env --profile "$system_profile" --delete-generations "${system_remove[@]}"
else
  echo "No NixOS generations older than $retention."
fi

echo "Collecting unreferenced Nix store paths..."
sudo nix-store --gc
